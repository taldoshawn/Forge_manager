<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fm_background">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_top_bar"
        android:paddingStart="4dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/menuButton"
            style="@style/TopIconButton"
            android:contentDescription="@string/menu"
            android:src="@drawable/ic_nav_menu"
            android:tint="#FFFFFF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="6dp">

            <com.forgemanager.app.features.explorer.PathJumpTextView
                android:id="@+id/activePath"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="/storage/emulated/0"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/folderInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#EAF5FF"
                android:textSize="10.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/moreButton"
            style="@style/TopIconButton"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_nav_more"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/fm_divider" />

    <LinearLayout
        android:id="@+id/panes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include
            android:id="@+id/leftPane"
            layout="@layout/view_file_pane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/paneDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/fm_divider" />

        <include
            android:id="@+id/rightPane"
            layout="@layout/view_file_pane"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_bottom_bar"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton android:id="@+id/backButton" style="@style/BottomIconButton" android:contentDescription="@string/back" android:src="@drawable/ic_nav_back" />
        <ImageButton android:id="@+id/forwardButton" style="@style/BottomIconButton" android:contentDescription="@string/forward" android:src="@drawable/ic_nav_forward" />
        <ImageButton android:id="@+id/createButton" style="@style/BottomIconButton" android:contentDescription="@string/create" android:src="@drawable/ic_nav_add" />
        <ImageButton android:id="@+id/syncButton" style="@style/BottomIconButton" android:contentDescription="@string/sync" android:src="@drawable/ic_nav_sync" />
        <ImageButton android:id="@+id/upButton" style="@style/BottomIconButton" android:contentDescription="@string/up" android:src="@drawable/ic_nav_up" />
    </LinearLayout>
</LinearLayout>
